---
layout: default
---
<div class="post home-layout">
  <aside class="home-sidebar" aria-label="Profile">
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {%
        include figure.liquid loading="eager" path=profile_image_path class="home-sidebar-avatar" sizes="180px" alt=page.profile.image
        cache_bust=true
      %}
    {% endif %}

    <h1 class="home-sidebar-name">Kun-Ying Lee</h1>
    <div class="home-sidebar-line">Undergraduate Student</div>
    <div class="home-sidebar-line">Tsinghua University</div>
    <div class="home-sidebar-line">lky25@mails.tsinghua.edu.cn</div>

    <div class="home-sidebar-icons social-icons" aria-label="Profile links">
      <a href="https://scholar.google.com/citations?user=KVnfzeYAAAAJ&hl=zh-TW&oi=sra" title="Google Scholar">
        <i class="ai ai-google-scholar"></i>
      </a>
      <a href="https://linkedin.com/in/kunying-lee" title="LinkedIn">
        <i class="fa-brands fa-linkedin"></i>
      </a>
      <a href="https://github.com/KunYing-Lee" title="GitHub">
        <i class="fa-brands fa-github"></i>
      </a>
      <a href="https://x.com/kunying_lee" title="X">
        <i class="fa-brands fa-x-twitter"></i>
      </a>
    </div>
  </aside>

  <article class="about-content home-main">
    <h2 id="about">About Me</h2>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 id="publications" style="margin-top: 2rem;">
        Publications
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Projects -->
    <h2 id="projects" style="margin-top: 2rem;">
      Projects
    </h2>
    <style>
      .project-img-container {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 15px;
        right: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .project-img-container figure, 
      .project-img-container picture {
        display: contents;
      }
      .project-img-container img {
        max-height: 100%;
        width: auto;
        max-width: 100%;
        object-fit: contain;
      }
    </style>
    <div class="projects projects-filter content-filter">
      <input class="content-filter-input" id="projects-filter-selected" type="radio" name="projects-filter" checked>
      <input class="content-filter-input" id="projects-filter-all" type="radio" name="projects-filter">

      <div class="content-filter-controls" aria-label="Project list filter">
        <label class="content-filter-label" for="projects-filter-selected">Selected</label>
        <span class="content-filter-divider" aria-hidden="true">|</span>
        <label class="content-filter-label" for="projects-filter-all">All</label>
      </div>

      <div class="projects-list">
        {% assign sorted_projects = site.projects | sort: "importance" %}
        {% for project in sorted_projects %}
          <div class="project-item mb-3">
            <div class="row">
              {% if project.img %}
              <div class="col-sm-5 col-md-3 position-relative">
                <div class="project-img-container">
                  {% include figure.liquid loading="eager" path=project.img sizes="200px" alt="project thumbnail" class="img-fluid rounded z-depth-1" %}
                </div>
              </div>
              <div class="col-sm-7 col-md-9">
              {% else %}
              <div class="col-12">
              {% endif %}

                <h5 class="mb-1"><strong><a href="{{ project.github }}" target="_blank" style="color: inherit; text-decoration: none;">{{ project.title }}</a></strong> <span class="text-muted" style="font-size: 0.9em;">({{ project.description }})</span></h5>
                <div class="project-content">
                  {{ project.content }}
                </div>
                {% if project.github %}
                  <div class="project-links mt-1">
                     <a href="{{ project.github }}" target="_blank" style="color: inherit; text-decoration: none;">
                        <i class="fa-brands fa-github"></i> {{ project.github | remove: "https://" | remove: "http://" }}
                     </a>
                  </div>
                {% endif %}

              </div> <!-- End col text -->
            </div> <!-- End row -->
          </div>
          {% unless forloop.last %}
          <hr class="my-3" style="border-top: 1px dashed var(--global-divider-color);">
          {% endunless %}
        {% endfor %}
      </div>
    </div>

    <!-- Experiences -->
    <h2 id="experiences" style="margin-top: 2rem;">
      Experiences
    </h2>
    <section class="experiences" aria-label="Experiences">
      <div class="experience-item">
        <div class="experience-logo">
          <img src="{{ '/assets/img/marslab.png' | relative_url }}" alt="MARS Lab logo" loading="lazy">
        </div>
        <div class="experience-content">
          <h3><a href="https://msimchowitz.github.io/" target="_blank" rel="noopener">MARS Lab, Tsinghua University</a></h3>
          <p><strong>Research Intern:</strong> 2025.12 - Present.</p>
          <p><strong><em>Topics:</em></strong> <em>Humanoid Locomotion, Foundation Models, VLAs.</em></p>
          <p><strong>Research Advisor:</strong> Prof. <a href="https://hangzhaomit.github.io/" target="_blank" rel="noopener">Hang Zhao</a>.</p>
        </div>
      </div>
      <div class="experience-item">
        <div class="experience-logo experience-logo-contain">
          <img src="{{ '/assets/img/thmos.png' | relative_url }}" alt="THMOS logo" loading="lazy">
        </div>
        <div class="experience-content">
          <h3><a href="https://www.thmos.org" target="_blank" rel="noopener">THMOS, Tsinghua University</a></h3>
          <p><strong>Gait Control Group:</strong> 2025.09 - Present.</p>
          <p><strong><em>Topics:</em></strong> <em>Soccer-Oriented Locomotion, Multi-Robot Coordination Logic.</em></p>
        </div>
      </div>
    </section>



    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
