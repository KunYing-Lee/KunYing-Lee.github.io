<dialog id="project-dialog" class="project-dialog" aria-labelledby="project-dialog-title"></dialog>
{% assign selected_projects = site.projects | where: 'selected', true %}
{% for project in selected_projects %}
  <template id="project-dialog-template-{{ project.modal_id }}">
    <header class="project-dialog-header">
      <div>
        <p class="project-dialog-eyebrow">{{ project.eyebrow }}</p>
        <h2 id="project-dialog-title">{{ project.title }}</h2>
        <p class="project-dialog-role">{{ project.role }}</p>
      </div>
      <button type="button" class="project-dialog-close" data-close-project aria-label="Close project details" autofocus>
        <span aria-hidden="true">&times;</span>
      </button>
    </header>
    <div class="project-dialog-body">
      <p class="project-dialog-intro">{{ project.dialog_intro }}</p>
      <div class="project-dialog-metrics">
        {% for metric in project.metrics %}
          <div class="project-dialog-metric">
            <strong>{{ metric.value }}</strong>
            <span>{{ metric.label }}</span>
          </div>
        {% endfor %}
      </div>
      <div class="project-dialog-layout">
        <div class="project-dialog-gallery">
          {% assign lead_video = project.media | first %}
          {% include project_video.liquid path=lead_video.path poster=lead_video.poster label=lead_video.label title=lead_video.title %}
          {% if project.media.size > 1 %}
            <div class="project-dialog-secondary">
              {% for video in project.media offset: 1 %}
                {% include project_video.liquid path=video.path poster=video.poster label=video.label title=video.title %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
        <aside class="project-dialog-notes" aria-label="Project contributions">
          <h3>My contributions</h3>
          {% for highlight in project.highlights %}
            <section class="project-dialog-highlight">
              <h4>{{ highlight.title }}</h4>
              <p>{{ highlight.text }}</p>
            </section>
          {% endfor %}
          <div class="project-dialog-next">
            <h3>Ongoing work</h3>
            <p>{{ project.ongoing }}</p>
          </div>
        </aside>
      </div>
    </div>
  </template>
{% endfor %}
