<div class="publications publications-filter content-filter">
  <input
    class="content-filter-input"
    id="publications-filter-selected"
    type="radio"
    name="publications-filter"
    checked
  >
  <input class="content-filter-input" id="publications-filter-all" type="radio" name="publications-filter">

  <div class="content-filter-controls" aria-label="Publication list filter">
    <label class="content-filter-label" for="publications-filter-selected">Selected</label>
    <span class="content-filter-divider" aria-hidden="true">|</span>
    <label class="content-filter-label" for="publications-filter-all">All</label>
  </div>

  {% bibliography --group_by none %}

  <p class="publication-note">* Equal Contribution, † Corresponding Author</p>
</div>
