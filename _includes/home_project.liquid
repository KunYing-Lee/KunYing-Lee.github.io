{% assign project = include.project %}
{% if project.github %}
  {% assign project_link = project.github %}
{% else %}
  {% assign project_link = project.url | relative_url %}
{% endif %}
<article class="project-item{% if project.selected %} project-selected{% endif %}">
  <div class="row align-items-start">
    {% if project.preview_video %}
      <div class="col-md-4 project-media-column">
        <video
          class="project-preview-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="{{ project.poster | relative_url | bust_file_cache }}"
          aria-label="{{ project.preview_label | default: project.title | escape }}"
        >
          <source src="{{ project.preview_video | relative_url | bust_file_cache }}" type="video/mp4">
        </video>
        {% if project.preview_label and project.selected != true %}
          <p class="project-media-label">{{ project.preview_label }}</p>
        {% endif %}
      </div>
    {% elsif project.img %}
      <div class="col-sm-5 col-md-3 project-media-column">
        {% include figure.liquid loading="lazy" path=project.img sizes="200px" alt=project.title class="img-fluid rounded z-depth-1" %}
      </div>
    {% endif %}
    <div class="{% if project.preview_video %}col-md-8{% elsif project.img %}col-sm-7 col-md-9{% else %}col-12{% endif %}">
      <h3 class="project-title">
        {% if project.title_link == false %}
          <span class="project-title-static">{{ project.title }}</span>
        {% elsif project.selected and project.modal_id %}
          <button type="button" class="project-title-trigger" data-project-dialog="{{ project.modal_id }}" aria-haspopup="dialog">
            {{ project.title }}
          </button>
        {% else %}
          <a
            href="{{ project_link }}"
            {% if project.github %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{- project.title -}}
          </a>
        {% endif %}
        {% unless project.selected -%}
          <span class="project-date">({{ project.description }})</span>
        {%- endunless %}
      </h3>
      {% if project.role and project.selected != true %}
        <p class="project-role">{{ project.role }}</p>
      {% endif %}
      <div class="project-content">
        {% if project.summary %}
          <p>{{ project.summary }}</p>
        {% else %}
          {{ project.content }}
        {% endif %}
      </div>
      {% include project_links.liquid project=project %}
      {% if project.github and project.selected != true %}
        <div class="project-links mt-1">
          <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer"
            ><i class="fa-brands fa-github" aria-hidden="true"></i> {{ project.github | remove: 'https://' | remove: 'http://' -}}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</article>
