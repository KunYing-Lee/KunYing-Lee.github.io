<figure class="project-video">
  <video
    {% if include.controls %}
      controls
    {% endif %}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="{{ include.poster | relative_url | bust_file_cache }}"
    aria-label="{{ include.title | escape }}"
  >
    <source src="{{ include.path | relative_url | bust_file_cache }}" type="video/mp4">
  </video>
  {% if include.label %}
    <figcaption>
      <strong>{{ include.label }}</strong> &middot; {{ include.title }}
    </figcaption>
  {% endif %}
</figure>
