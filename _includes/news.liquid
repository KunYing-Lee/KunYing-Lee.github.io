<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="news-timeline-wrapper">
      {% assign news = site.news | reverse %}
      {% assign news_visible_limit = 3 %}
      {% assign use_older_toggle = false %}
      {% if include.limit and news_size > news_visible_limit %}
        {% assign use_older_toggle = true %}
      {% endif %}
      {% if use_older_toggle %}
        <input class="news-older-control" type="checkbox" id="news-older-toggle">
      {% endif %}
      <ol class="news-timeline{% if use_older_toggle %} news-timeline-collapsible{% endif %}">
        {% if use_older_toggle %}
          {% for item in news limit: news_visible_limit %}
            <li class="news-timeline-item">
              <time class="news-timeline-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
              {% assign item_content = item.content | remove: '<p>' | remove: '</p>' | emojify %}
              {% assign gallery_control_id = nil %}
              {% if item_content contains 'news-gallery-control' %}
                {% assign gallery_control_id = item_content | split: 'class="news-gallery-control" type="checkbox" id="' | last | split: '"' | first %}
              {% endif %}
              {% if gallery_control_id %}
                <label class="news-timeline-marker news-gallery-toggle-marker" for="{{ gallery_control_id }}" aria-label="Toggle gallery"></label>
              {% else %}
                <span class="news-timeline-marker" aria-hidden="true"></span>
              {% endif %}
              <div class="news-timeline-content">
                {% if item.inline %}
                  {% if gallery_control_id %}
                    {% assign item_parts = item_content | split: '<div class="news-gallery">' %}
                    {{ item_parts[0] }}
                  {% else %}
                    {{ item_content }}
                  {% endif %}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
              {% if item.inline and gallery_control_id %}
                {% assign gallery_content = item_parts[1] | prepend: '<div class="news-gallery">' %}
                <div class="news-timeline-gallery">{{ gallery_content }}</div>
              {% endif %}
            </li>
          {% endfor %}
          <li class="news-timeline-item news-older-toggle-item">
            <label class="news-timeline-date news-older-toggle-label" for="news-older-toggle">Older News</label>
            <label class="news-timeline-marker news-older-toggle-marker" for="news-older-toggle" aria-label="Toggle older news"></label>
            <div class="news-timeline-content"></div>
          </li>
          {% for item in news offset: news_visible_limit %}
            <li class="news-timeline-item news-older-item">
              <time class="news-timeline-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
              {% assign item_content = item.content | remove: '<p>' | remove: '</p>' | emojify %}
              {% assign gallery_control_id = nil %}
              {% if item_content contains 'news-gallery-control' %}
                {% assign gallery_control_id = item_content | split: 'class="news-gallery-control" type="checkbox" id="' | last | split: '"' | first %}
              {% endif %}
              {% if gallery_control_id %}
                <label class="news-timeline-marker news-gallery-toggle-marker" for="{{ gallery_control_id }}" aria-label="Toggle gallery"></label>
              {% else %}
                <span class="news-timeline-marker" aria-hidden="true"></span>
              {% endif %}
              <div class="news-timeline-content">
                {% if item.inline %}
                  {% if gallery_control_id %}
                    {% assign item_parts = item_content | split: '<div class="news-gallery">' %}
                    {{ item_parts[0] }}
                  {% else %}
                    {{ item_content }}
                  {% endif %}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
              {% if item.inline and gallery_control_id %}
                {% assign gallery_content = item_parts[1] | prepend: '<div class="news-gallery">' %}
                <div class="news-timeline-gallery">{{ gallery_content }}</div>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          {% for item in news %}
          <li class="news-timeline-item">
            <time class="news-timeline-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            {% assign item_content = item.content | remove: '<p>' | remove: '</p>' | emojify %}
            {% assign gallery_control_id = nil %}
            {% if item_content contains 'news-gallery-control' %}
              {% assign gallery_control_id = item_content | split: 'class="news-gallery-control" type="checkbox" id="' | last | split: '"' | first %}
            {% endif %}
            {% if gallery_control_id %}
              <label class="news-timeline-marker news-gallery-toggle-marker" for="{{ gallery_control_id }}" aria-label="Toggle gallery"></label>
            {% else %}
              <span class="news-timeline-marker" aria-hidden="true"></span>
            {% endif %}
            <div class="news-timeline-content">
              {% if item.inline %}
                {% if gallery_control_id %}
                  {% assign item_parts = item_content | split: '<div class="news-gallery">' %}
                  {{ item_parts[0] }}
                {% else %}
                  {{ item_content }}
                {% endif %}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
            {% if item.inline and gallery_control_id %}
              {% assign gallery_content = item_parts[1] | prepend: '<div class="news-gallery">' %}
              <div class="news-timeline-gallery">{{ gallery_content }}</div>
            {% endif %}
          </li>
          {% endfor %}
        {% endif %}
      </ol>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
